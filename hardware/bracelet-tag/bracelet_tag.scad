// GenoMed AI emergency bracelet tag — generated by make_tag.js, edit the template instead.
// QR text: HTTPS://GENOMED-AI-JADE.VERCEL.APP/B/NINO26
//
// The QR only scans if the raised squares are a DIFFERENT COLOUR from the plate
// (dark squares on a light plate). Print it one of two ways:
//   1. One extruder: print "all", and add a filament change (M600 / "pause at height")
//      at the layer just above plate_t (2.4 mm by default): white first, then black.
//   2. Two colours / AMS: export part="base" (white) and part="qr" (black) as two STLs,
//      load both into the slicer as one multi-part object, and assign a filament to each.
//
// Settings that work: 0.4 mm nozzle, 0.12–0.16 mm layers, PLA or PETG, no supports,
// plate flat on the bed. Test-scan it with a phone camera before giving it to anyone.

part = "all";          // "all", "base" or "qr"

// ---- size (mm) ----
qr_mm      = 27;       // printed width of the QR including its white border
quiet      = 2;        // white border around the code, in QR squares (QR needs ≥ 2 here)
plate_w    = 44;       // tag width (strap runs through the side slots)
plate_h    = 32;       // tag height
plate_t    = 2.4;      // plate thickness
corner_r   = 4;        // rounded corners
dot_h      = 0.6;      // how far the dark squares stand up
slot_w     = 2.6;      // strap slot width
slot_len   = 24;       // strap slot length (fits a 20–22 mm watch strap)
slot_x     = 18.6;     // slot centre distance from the middle
back_text  = ["IN AN EMERGENCY", "SCAN THE QR", "CALL 112"];
text_depth = 0.4;      // engraved on the back

// ---- QR pattern ----
qr_n = 29;
qr_rows = [
  "11111110101000000011001111111",
  "10000010001010001101101000001",
  "10111010011011011011101011101",
  "10111010110010111010101011101",
  "10111010101001101110101011101",
  "10000010111111110100001000001",
  "11111110101010101010101111111",
  "00000000100000100111100000000",
  "10001011110001111110111111001",
  "00111100010010000000100110100",
  "10011010011001110110000000101",
  "10100101000001011011010010001",
  "01010010101001000100101110010",
  "00000001101011101110010010001",
  "11111111110100001100111001001",
  "01111000101100100010011111110",
  "11010111111001111010010100101",
  "10000000111010000101111011101",
  "00101011001011110001111000110",
  "00011100000011011100000101101",
  "11111111110001000011111110100",
  "00000000101101101111100010011",
  "11111110111110001110101010110",
  "10000010000100100100100010101",
  "10111010101001110110111111110",
  "10111010011001000100111100110",
  "10111010010101011001001110011",
  "10000010011000011100001011010",
  "11111110101010011011110101000"
];

cell = qr_mm / (qr_n + 2 * quiet);
echo(str("QR square size = ", cell, " mm (keep ≥ 0.8 mm for a 0.4 mm nozzle)"));

module rounded_plate() {
  linear_extrude(plate_t)
    offset(r = corner_r, $fn = 48) offset(delta = -corner_r)
      square([plate_w, plate_h], center = true);
}

module slots() {
  for (sx = [-slot_x, slot_x])
    translate([sx, 0, -1])
      linear_extrude(plate_t + 2)
        hull() for (sy = [-1, 1]) translate([0, sy * (slot_len - slot_w) / 2]) circle(d = slot_w, $fn = 32);
}

module back_engraving() {
  translate([0, 0, -0.01]) linear_extrude(text_depth + 0.01)
    mirror([1, 0, 0])   // mirrored so it reads correctly when you turn the tag over
      for (i = [0 : len(back_text) - 1])
        translate([0, (len(back_text) - 1) / 2 * 4.4 - i * 4.4])
          text(back_text[i], size = 2.6, halign = "center", valign = "center",
               font = "Liberation Sans:style=Bold");
}

module base() {
  difference() { rounded_plate(); slots(); back_engraving(); }
}

// Dark squares, merged into horizontal runs so the mesh stays small and clean.
module qr_dots() {
  origin = -(qr_n * cell) / 2;
  for (y = [0 : qr_n - 1]) {
    r = qr_rows[y];
    for (x = [0 : qr_n - 1])
      if (r[x] == "1" && (x == 0 || r[x - 1] == "0")) {
        run = run_len(r, x);
        translate([origin + x * cell, -origin - (y + 1) * cell, plate_t])
          cube([run * cell, cell, dot_h]);
      }
  }
}
function run_len(r, x) = (x < len(r) && r[x] == "1") ? 1 + run_len(r, x + 1) : 0;

if (part == "base") base();
else if (part == "qr") qr_dots();
else { color("white") base(); color("black") qr_dots(); }
